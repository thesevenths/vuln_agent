# 复制为 .env 后填写。由 config.py 在 import 时加载。

# --- 本地文件读写（FileTool，Windows / Linux）---
# FileTool 读取根目录（用于补齐证据 L2，见 evidence_levels.py；L1 由 Joern 负责）
AGENT_FILE_READ_ROOTS=
AGENT_REPORT_DIR=agent_reports
AGENT_AUTO_SAVE_REPORT=1
AGENT_FILE_MAX_READ_BYTES=262144

# --- LLM（llm_client / chains / planner）---
QWEN_PLUS_API_KEY=
QWEN_PLUS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_PLUS_MODEL=qwen-plus

# --- PostgreSQL（db_connector）---
# 二选一：完整 DSN，或下面拆分字段
PG_DSN=
DB_NAME=
USER_NAME=
PASS_WORD=
DB_HOST=
DB_PORT=

# --- Joern（joern_vuln_scanner / queries / main）---
JOERN_URL=http://192.168.50.81:8080
PROJECT_PATH=
JOERN_PROJECT_NAME=VulnerableApp
# C/C++ 查询：默认已合并 generic+embedded（见 queries.cpp_queries_merged），variant 不再切换整包
JOERN_CPP_VARIANT=generic
# 仅调试 mbedtls 窄路径过滤旧包时设为 1
JOERN_CPP_USE_LEGACY_VENDOR=0
JOERN_MAX_PATH_LEN=10
JOERN_FORCE_GENERIC=0
JOERN_AUTO_RERUN_ON_VARIANT_SWITCH=0
JOERN_ENABLE_HARD_BACKTRACE=1
# 单条污点查询最多分析的 flow 数（按 path 拆分）
JOERN_MAX_FLOWS_PER_QUERY=5
# 硬回溯每层仅对 top-K 高分 caller 拉取 dumpRaw 方法体
JOERN_HARD_BACKTRACE_TOP_CALLER_BODIES=2
# 初步分析后的反证复核（1=开启）
JOERN_ENABLE_REFUTATION=1
# 单条 flow 主分析 max_tokens（默认 4500，便于输出完整 PoC）
JOERN_ANALYSIS_MAX_TOKENS=4500
# 终态/PoC 校验失败时自动重写分析（1=开启）；仍失败则系统覆写为 ❌ 否
JOERN_ENABLE_VERDICT_RETRY=1
# 硬回溯 caller 体防御检测：正则未命中时用 LLM 语义判断（1=开启）
JOERN_LLM_GUARD_CHECK=1
# 单次 Joern HTTP 默认超时（秒）；污点 batch 内单条仍可能用 180/300 显式超时
JOERN_QUERY_TIMEOUT=120
# 连续「真实查询」失败 N 次后熔断（健康探测 1+1 失败不计数，避免 Joern 忙时误判）
JOERN_CIRCUIT_BREAKER_LIMIT=5
# 软健康探测超时（秒）；Joern 执行重查询时可能较慢，默认 45
JOERN_HEALTH_CHECK_TIMEOUT=45
# 1=有失败记录时先发 1+1 探测（仅日志）；0=关闭探测
JOERN_HEALTH_PROBE=1
# 审计 JSONL/HTML 中 joern_query_executed.query_source 取值说明：
#   queries_py_initial | queries_py_initial_fallback | queries_py_reflection | queries_py_cpp_auxiliary
#   llm_follow_up_query | llm_template_expansion
#   hard_backtrace_caller_list | hard_backtrace_caller_body
# C++ 间接调用辅助 pass（默认 0=关闭，不改变主污点流程；1=在报告末尾追加附录）
JOERN_CPP_INDIRECT_AUX=0

# --- C/C++ 污点批次稳定性（见 docs/CppJoern扫描稳定性.md）---
# 1=先 generic 再 embedded 两阶段；0=单次 merged 批次
JOERN_CPP_SCAN_PHASES=1
JOERN_QUERY_BATCH_PAUSE_SEC=2
JOERN_CPP_PHASE_PAUSE_SEC=15
JOERN_CPP_TAINT_QUERY_TIMEOUT=180
JOERN_CPP_TAINT_QUERY_TIMEOUT_HEAVY=240
JOERN_CPP_TAINT_RETRIES=1
# 1=每类成功后写 agent_reports/checkpoints/<项目>.json，熔断后续扫
JOERN_CPP_CHECKPOINT=1
JOERN_CPP_CHECKPOINT_DIR=agent_reports/checkpoints
# 1=忽略检查点、全量重扫
JOERN_CPP_CHECKPOINT_RESET=0
# 空结果时去掉 path 深度 filter 再查；熔断期间自动跳过
JOERN_CPP_ENABLE_FALLBACK=1
JOERN_CPP_FALLBACK_TIMEOUT=300

# --- java-audit-skills 集成（java_audit_bridge / JavaAuditTool）---
JAVA_AUDIT_SKILLS_PATH=vendor/java-audit-skills
JAVA_AUDIT_PLAYBOOK_MAX_CHARS=12000

# --- Agent CLI（main / planner）---
AGENT_LANGUAGE=cpp
AGENT_MAX_ITERS=3
AGENT_AUDIT_LOG_PATH=
AGENT_LOCAL_SOURCE_PATH=
