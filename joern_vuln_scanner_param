保守档（小算力 / 快速反馈）
适合：先看趋势、快速试跑

JOERN_ENABLE_HARD_BACKTRACE=1
JOERN_HARD_BACKTRACE_MAX_HOPS=3
JOERN_HARD_BACKTRACE_BRANCHING=2
JOERN_HARD_BACKTRACE_CALLER_LIMIT=4
JOERN_HARD_BACKTRACE_MAX_METHODS=12
JOERN_HARD_BACKTRACE_STAGNATION_LIMIT=1
