  "output_schema": {
    "vulnerability_confirmed": "boolean",
    "confidence": "float (0-1)",
    "cwe_mapping": "CWE-269",
    "privilege_change_type": "array — 权限管理缺陷类型 (如 ['role_escalation', 'self_elevation', 'mass_assignment', 'default_excess_privilege', 'residual_privilege'])",
    "tainted_privilege_param": "string (指出具体哪个角色/权限参数来自客户端且未被校验)",
    "missing_auth_check": "string (描述应添加但未添加的操作者权限校验逻辑)",
    "anti_pattern_hit": "array — 命中的反向模式 (如 ['mass_assignment_privilege_fields.java', 'self_elevation.java', 'default_excess_privilege.python'])",
    "control_missing": "array — 缺失的安全控制 (如 ['operator_authorization_check', 'privilege_field_isolation', 'role_value_whitelist', 'self_elevation_prevention'])",
    "profile_difference_found": "boolean — 是否发现多环境配置安全差异",
    "exemption_path_issue_found": "boolean — 是否发现认证豁免路径包含权限变更操作",
    "reasoning_trace": "string",
    "business_impact": "string",
    "risk_level": "CRITICAL",
    "remediation": "string"
  }
