  "anti_patterns": {
    "description": "以下模式匹配到时应立即报警——它们代表权限管理中的高风险反模式",
    "mass_assignment_privilege_fields": {
      "description": "权限字段通过自动绑定机制被客户端污染",
      "java": [
        "@RequestBody.*User(?!DTO)",
        "@ModelAttribute.*User",
        "user\\.setRole\\(.*request",
        "user\\.setIsAdmin\\(.*request",
        "BeanUtils\\.copyProperties.*request.*user",
        "modelMapper\\.map.*request.*user",
        "without.*@JsonIgnore.*role",
        "without.*@JsonProperty.*access.*READ_ONLY.*role"
      ],
      "python": [
        "User\\(\\*\\*request\\.",
        "is_superuser.*=.*request",
        "is_staff.*=.*request",
        "role.*=.*request\\.form",
        "role.*=.*request\\.json",
        "ModelForm.*User",
        "save\\(\\).*commit.*True.*without.*exclude.*role"
      ],
      "php": [
        "User::create\\(\\$request->all\\(\\)\\)",
        "->update\\(\\$request->all\\(\\)\\)",
        "\\$fillable.*role",
        "\\$fillable.*is_admin",
        "without.*\\$guarded.*role",
        "\\$_POST.*role",
        "\\$_POST.*is_admin"
      ],
      "go": [
        "json\\.Decode.*&user.*role",
        "ShouldBindJSON.*struct.*Role",
        "c\\.BindJSON.*User.*Role"
      ],
      "javascript": [
        "Object\\.assign.*user.*req\\.body",
        "spread.*req\\.body.*user",
        "\\.create\\(req\\.body\\)",
        "\\.update\\(req\\.body\\)",
        "User\\.findByIdAndUpdate.*req\\.body",
        "without.*select.*omit.*role"
      ],
      "dotnet": [
        "UpdateModel.*user",
        "TryUpdateModelAsync.*user",
        "_context\\.Update.*user.*without.*Role.*check"
      ],
      "ruby": [
        "params\\.require\\(:user\\)\\.permit!",
        "update_attributes.*params",
        "User\\.create.*params",
        "assign_attributes.*params.*without.*permit"
      ],
      "rust": [
        "serde::Deserialize.*role.*without.*deny",
        "Json<UserUpdate>.*role"
      ]
    },
    "self_elevation": {
      "description": "用户可通过接口提升自己的角色或权限",
      "java": [
        "setRole\\(.*request.*role",
        "currentUserId.*==.*targetUserId.*setRole",
        "principal.*setRole",
        "SecurityContextHolder.*user.*setRole"
      ],
      "python": [
        "current_user\\.id.*==.*user_id.*set_role",
        "request\\.user.*update.*role",
        "is_admin.*=.*True.*request"
      ],
      "php": [
        "Auth::id\\(\\).*==.*\\$id.*setRole",
        "\\$user->assignRole.*request"
      ],
      "generic": [
        "currentUser.*setRole",
        "self.*promote",
        "me.*role.*admin"
      ]
    },
    "residual_privilege": {
