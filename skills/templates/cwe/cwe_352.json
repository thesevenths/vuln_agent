    ],
    "semantic_keywords": [
      "csrf", "xsrf", "cross-site", "state-changing", "SameSite", "csrf_token",
      "anti-forgery", "_token", "X-CSRF-TOKEN"
    ],
    "file_context": ["controller", "form", "security_config", "filter"]
  },
  "logic_query_keywords": {
    "java": {
      "state_changing": ["POST", "PUT", "DELETE", "PATCH", "transfer", "delete", "update", "create", "payment"],
      "csrf_guards": ["csrf", "CsrfFilter", "csrfToken", "X-CSRF-TOKEN", "_csrf", "enableCsrf"],
      "cookie_flags": ["SameSite", "HttpOnly", "Secure"]
    },
    "express": {
      "state_changing": ["post", "put", "delete", "patch"],
      "csrf_guards": ["csurf", "csrf", "csrfProtection", "X-CSRF-TOKEN"],
      "cookie_flags": ["sameSite", "httpOnly", "secure"]
    },
    "generic": {
      "state_changing": ["POST", "PUT", "DELETE", "PATCH", "transfer", "delete", "update"],
      "csrf_guards": ["csrf", "xsrf", "anti-forgery", "csrf_token", "_token"],
      "cookie_flags": ["SameSite", "HttpOnly", "Secure"]
    }
  },
  "reasoning_workflow": [
    "Step 1: 识别改变服务端状态的操作（转账、改密、删数据、下单、授权变更）。",
    "Step 2: 检查是否仅依赖 Cookie 会话而无 CSRF token、Referer/Origin 校验或 SameSite 保护。",
    "Step 3: 评估攻击面：该操作是否可在受害者已登录时被第三方站点以表单/fetch 触发。",
    "Step 4: 区分只读 GET 与状态变更接口；仅对后者要求 CSRF 防护。",
    "Step 5: 若状态变更接口缺少有效 CSRF 防护且依赖会话 Cookie → CWE-352。"
  ],
  "sanitizers": [
    "框架级 CSRF token 校验（Spring Security csrf、Django csrfmiddleware）",
    "SameSite=Strict/Lax 且敏感操作额外要求自定义头/token",
    "双重 Cookie 或 Origin/Referer 白名单校验",
    "状态变更接口要求不可跨站自动携带的 Authorization 头（非 Cookie）"
  ],
  "output_schema": {
    "vulnerability_confirmed": "boolean",
    "confidence": "float (0-1)",
